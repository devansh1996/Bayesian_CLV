*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot
*.out
*.run.xml
*.log
texts/thesis.pdf
texts/thesis_clv.pdf
texts/pdflatex_out.txt
texts/pdflatex_err.txt

